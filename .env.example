# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SHADOWTRACE_SECRET_KEY=replace-with-a-long-random-secret

# Optional provider keys. The dashboard works without them and clearly marks them as disabled.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Local development settings
SHADOWTRACE_COOKIE_SECURE=false
SHADOWTRACE_REQUEST_TIMEOUT=7
SHADOWTRACE_THREAT_CACHE_MINUTES=60
SHADOWTRACE_THREAT_CACHE_MAX_ENTRIES=1000
SHADOWTRACE_THREAT_MAX_RESPONSE_BYTES=1048576
# Use live only after reviewing provider privacy/retention terms and configuring intended keys.
SHADOWTRACE_THREAT_INTEL_MODE=offline
SHADOWTRACE_PAGE_SIZE=10
# SHADOWTRACE_DATABASE=/absolute/path/to/shadowtrace.db
